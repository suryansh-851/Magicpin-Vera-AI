# Copy to .env and fill in real values. Never commit the real .env.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional — bot identity for /v1/metadata
TEAM_NAME=Vera+
TEAM_MEMBERS=Suryansh Singh
SUBMITTED_AT=

# Optional — tuning (defaults are fine for most runs)
TICK_BUDGET_SECONDS=8
REPLY_BUDGET_SECONDS=9
COMPOSE_WORKERS=12
LLM_COMPOSE=off
LLM_REASONING_EFFORT=low
CUSTOMER_HISTORY_IN_COPY=on
